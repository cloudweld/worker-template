{
  "name": "ooky-worker-template",
  "version": "0.3.1",
  "description": "Deployable Cloudflare Worker template for the Ooky BYO-Worker integration tier. Customer deploys this to their own Cloudflare account.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "wrangler": "^4.114.0",
    "vitest": "^4.1.10"
  }
}
